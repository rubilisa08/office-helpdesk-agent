# 사용법: 이 파일을 복사해서 이름을 .env 로 바꾸고, 아래 = 뒤에 키를 붙여 넣으세요.
#   (.env는 .gitignore에 있어서 GitHub에 올라가지 않습니다. 이 .env.example에는 키를 넣지 마세요.)
#
# 키 발급: https://aistudio.google.com/apikey → "Create API key"
#   무료 한도는 '프로젝트' 단위입니다. 한도를 새로 받으려면 키를 만들 때 "새 프로젝트에서 만들기"를 고르세요.

GEMINI_API_KEY=

# 모델은 코드 기본값(gemini-3.5-flash)을 씁니다. 바꾸고 싶을 때만 앞의 #을 지우세요.
# GEMINI_MODEL=gemini-3.5-flash

# (선택) OpenAI를 쓰려면
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# (선택) Jev 의사결정 모델 — python evaluate.py --decider jev, 데모 앱의 'jev' 선택에 쓰입니다
# JEV_API_KEY=
# JEV_PROVIDER=typesafe        # typesafe(api.typesafe.ai) | aimlapi(api.aimlapi.com)
# JEV_MODEL=                   # 비우면 제공처 기본 모델

# (선택) OpenRouter로 Jev 사용 — TypeSafe 계정·대기 없이 가능. JEV_API_KEY 대신 이 줄만 넣으면 됩니다
# OPENROUTER_API_KEY=

# (선택) Laya — Jev 호환 오픈 가중치 결정 모델을 Railway에 직접 배포한 경우(JEV_API_KEY 대신)
# LAYA_API_KEY=                # Railway → Laya 서비스 → Variables 탭
# LAYA_BASE_URL=               # https://<도메인>.up.railway.app (Settings → Networking)
